# Copy to .env on the server and fill in. Never commit .env. Keep file permissions at 600.

PORT=3000

# --- Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
VITE_SUPABASE_ANON_KEY=

# --- Telegram (required)
BOT_TOKEN=
ADMIN_GROUP_ID=
# Optional but recommended: random string; pass the same value as secret_token to setWebhook
TELEGRAM_WEBHOOK_SECRET=

# --- Public addresses
MINIAPP_URL=https://shop.example.uz
WEBAPP_URL=https://shop.example.uz/
ADMIN_ORIGIN=https://www.example.uz
ADMIN_DASHBOARD_URL=https://www.example.uz/admin/bot

# --- Payme (the CLIENT's own merchant account)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=false
PAYME_TEST_MERCHANT_ID=
PAYME_TEST_SECRET_KEY=

# --- Click (only after the Click webhook exists; not built yet)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=

# --- Cron endpoint (close-stale-deliveries). Required: the Vercel cron header is ignored here
CRON_SECRET=

# --- Bot session store (used by api/bot.js)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: serve a built site or mini app from this folder, with SPA fallback
# STATIC_DIR=/home/USER/public_html
