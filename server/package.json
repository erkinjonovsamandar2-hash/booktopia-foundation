{
  "name": "booktopia-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs the Booktopia API handlers as a plain Node.js server for non-Vercel hosting.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "sync": "node sync-handlers.mjs",
    "prestart": "npm run sync",
    "start": "node --env-file=.env index.mjs",
    "test": "npm run sync && node smoke-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/redis": "^1.34.0",
    "express": "^4.21.0"
  }
}
